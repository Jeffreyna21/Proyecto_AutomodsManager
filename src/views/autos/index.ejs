<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Autos - AutoMods Manager</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
      <h1>🚗 Mis Autos</h1>
      <a href="/autos/new" class="btn btn-primary">+ Agregar Auto</a>
    </div>

    <% if (success && success.length > 0) { %>
      <% success.forEach(msg => { %>
        <div class="alert alert-success"><%= msg %></div>
      <% }) %>
    <% } %>

    <% if (error && error.length > 0) { %>
      <% error.forEach(msg => { %>
        <div class="alert alert-error"><%= msg %></div>
      <% }) %>
    <% } %>

    <% if (autos.length === 0) { %>
      <div class="empty-state">
        <p style="font-size: 18px;">No hay autos registrados</p>
        <p>Comienza agregando tu primer auto</p>
      </div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Placa</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Año</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% autos.forEach(auto => { %>
            <tr>
              <td><%= auto.placa %></td>
              <td><%= auto.marca %></td>
              <td><%= auto.modelo %></td>
              <td><%= auto.anio %></td>
              <td>
                <div class="actions">
                  <a href="/autos/<%= auto.id %>" class="btn btn-secondary">Ver</a>
                  <a href="/autos/<%= auto.id %>/edit" class="btn btn-primary">Editar</a>
                  <form action="/autos/<%= auto.id %>?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('¿Estás seguro? Esto eliminará el auto y todas sus modificaciones.')">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (hasPrevPage) { %>
            <a href="/autos?page=<%= currentPage - 1 %>">← Anterior</a>
          <% } else { %>
            <span style="opacity: 0.5;">← Anterior</span>
          <% } %>

          <span class="active">Página <%= currentPage %> de <%= totalPages %></span>

          <% if (hasNextPage) { %>
            <a href="/autos?page=<%= currentPage + 1 %>">Siguiente →</a>
          <% } else { %>
            <span style="opacity: 0.5;">Siguiente →</span>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
