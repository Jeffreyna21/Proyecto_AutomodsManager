<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Auto - AutoMods Manager</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="container">
    <h1>Editar Auto</h1>

    <% if (error && error.length > 0) { %>
      <% error.forEach(msg => { %>
        <div class="alert alert-error"><%= msg %></div>
      <% }) %>
    <% } %>

    <div class="card">
      <form action="/autos/<%= auto.id %>?_method=PUT" method="POST">
        <div class="form-group">
          <label for="placa">Placa *</label>
          <input type="text" id="placa" name="placa" value="<%= auto.placa %>" required
                 style="text-transform: uppercase;">
          <small style="color: #718096;">Formato Ecuador: 3 letras + 3 o 4 dígitos (con o sin guion)</small>
        </div>

        <div class="form-group">
          <label for="id_marca">Marca *</label>
          <select id="id_marca" name="id_marca" required>
            <option value="">Seleccione una marca</option>
            <% marcas.forEach(marca => { %>
              <option value="<%= marca.id %>" <%= marca.id === auto.id_marca ? 'selected' : '' %>><%= marca.nombre %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="id_modelo">Modelo *</label>
          <select id="id_modelo" name="id_modelo" required data-selected="<%= auto.id_modelo %>">
            <option value="">Cargando modelos...</option>
          </select>
        </div>

        <div class="form-group">
          <label for="anio">Año *</label>
          <input type="number" id="anio" name="anio" value="<%= auto.anio %>" min="1900" max="2100" required>
        </div>

        <div class="actions">
          <button type="submit" class="btn btn-success">Guardar Cambios</button>
          <a href="/autos/<%= auto.id %>" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <script src="/js/dropdownMarcaModelo.js"></script>
</body>
</html>
